<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_moveit_config</name>
  <version>0.1.0</version>
  <description>
    MoveIt 2 configuration for mobile_manipulator_description: planning groups arm (N-DOF) and
    lift_arm (1 + N DOF), named by the robot profile, KDL kinematics, OMPL, joint limits with explicit velocity / acceleration
    scaling, and a mock-hardware demo (ros2_control) for the UR, generic 6-DOF and Panda-like 7-DOF arms.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>mobile_manipulator_description</depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>moveit_ros_planning</test_depend>
  <test_depend>rclcpp</test_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>pick_ik</exec_depend>
  <exec_depend>trac_ik_kinematics_plugin</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>compliant_trajectory_controller</exec_depend>
  <exec_depend>ft_bridge_hardware</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
