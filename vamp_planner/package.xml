<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vamp_planner</name>
  <version>0.1.0</version>
  <description>
    VAMP (SIMD CPU sampling-based planner) behind the motion_planner ports: free-space planning
    and collision checks, ROS-free. Upstream VAMP is consumed unmodified from /opt/vamp.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>core_types</depend>
  <depend>motion_planner</depend>
  <depend>pluginlib</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
