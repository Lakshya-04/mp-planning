<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>curobo_planner</name>
  <version>0.1.0</version>
  <description>
    C++ client that implements the motion_planner Planner port by calling the cuRobo planner node's
    services (curobo_bridge), so the planning layer can select cuRobo like any other backend.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>core_types</depend>
  <depend>motion_planner</depend>
  <depend>scene_model</depend>
  <depend>curobo_bridge_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
