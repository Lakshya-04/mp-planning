Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: moveit_rviz_plugin/MotionPlanning
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Planning Request:
        Planning Group: lift_arm
  Global Options:
    Fixed Frame: base_footprint
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point: {X: 0, Y: 0, Z: 1.0}
